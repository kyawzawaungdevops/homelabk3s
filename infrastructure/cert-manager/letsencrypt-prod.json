{
  "apiVersion": "cert-manager.io/v1",
  "kind": "ClusterIssuer",
  "metadata": {
    "name": "letsencrypt-prod",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "1"
    }
  },
  "spec": {
    "acme": {
      "email": "kyawzawaung321@gmail.com",
